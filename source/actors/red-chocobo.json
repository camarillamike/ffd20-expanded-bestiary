      "system": {
        "description": {
          "value": "<p>2/day, a red chocobo can blast an opponent with flame within 30 ft. The red chocobo must make a ranged touch attack (+5), if it hits, the attack deals 3d6+5 fire damage and inflicts the Burning status effect for 1d4 rounds (Reflex save DC 13 to negate). Blue mages may learn this ability as a 2nd level spell (Knowledge: Arcana DC 19).</p>",
          "instructions": ""
        },
        "actions": [
          {
            "name": "Choco Flame",
            "actionType": "rsak",
            "activation": {
              "cost": 1,
