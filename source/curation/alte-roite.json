    "rawSections": {
      "HEADER": [
        "Alte Roite (CR 15)",
        "XP 51,200",
        "NE Medium Humanoid (Mini-Boss)",
        "Init +10; Senses Perception +29"
      ],
      "DEFENSE": [
        "AC 32, touch 22, flat-footed 26 (+6 Dex, +6 Wis, +10 natural)",
        "hp 250 [320] (20d8+160)",
        "Fort +13, Ref +12, Will +20",
        "DR 15/magic; SR 25"
      ],
      "OFFENSE": [
        "Speed 30 ft.",
        "Melee quarterstaff +28/+23/+18 (1d6+12/19-20)",
        "Special Attacks Encircle",
        "Special Abilities Alternate Form"
      ],
      "STATISTICS": [
        "Str 23, Dex 22, Con 24, Int 12, Wis 23, Cha 12",
        "Base Atk +15; CMB +21; CMD 43",
        "Feats Ability Focus (Encircle), Improved Critical (Bite), Improved Critical (Quarterstaff), Improved Initiative, Iron Will, Lightning Reflexes, Multiattack, Power Attack, Toughness, Weapon Focus (Bite)",
        "Skills Bluff +21, Fly +26, Perception +29",
        "Languages Common, Draconic",
        "SQ AC Bonus, Mighty Staff",
        "Gear mwk quarterstaff"
      ],
      "SPECIAL ABILITIES": [
        "AC Bonus (ex) An alte roite adds his Wisdom bonus to his AC and CMD.",
        "Alternate Form (su) An alte roite may return to his form as a jura aevis as a swift action, or automatically as an immediate action when reduced to 0 or fewer hit points. Damage taken by the alte roite form carries over to the jura aevis, but negative status effects are removed.",
        "Mighty Staff (ex) An alte roite adds his Wisdom bonus to attack and damage with quarterstaffs.",
        "Encircle (su) An alte roite can cast a creature outside of time and space, temporarily negating its existence. If it fails a Will save (DC 28), it is inflicted with the Banished status effect for 6 rounds; it and all items it is carrying disappear into nothingness, ceasing to exist. At the end of this effect's duration, that creature reappears where it was. If another creature or object is occupying the space it reappears in, then the target is shunted off to the nearest open space and takes 1d6 points of damage per 5 ft. it traveled. Blue mages may learn this ability as a 4th level spell (Knowledge: Local DC 23)."
      ],
      "ECOLOGY": [
        "Environment the Void",
        "Organization solitary",
        "Treasure standard"
      ]
    },
