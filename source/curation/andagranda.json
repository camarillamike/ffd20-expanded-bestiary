      "specialAbilities": [
        {
          "name": "Critical Attack",
          "type": "ex",
          "description": "As a standard action, the andagranda can inflict more pain than normal. If they succeed at hitting with their bite attack, the damage is 3d6+9 x 1.5 for total damage.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Poison",
          "type": "ex",
          "description": "Bite or sting — injury; save Fort DC 27; frequency 1/round for 6 rounds; effect 2d6 non-elemental damage; cure 1 save. The save DC is Constitution-based and includes a +2 racial bonus.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Earthquake",
          "type": "su",
          "description": "Once every 1d3+1 rounds, an andagranda can cause the ground to erupt around it within a 30-ft.-radius. Creatures within the area of effect take 8d6 points of earth damage and are inflicted with the Weighted status effect for 1d6 rounds. They must make a Reflex save (DC 25) for half damage and to negate the status effect. The save DC is Constitution-based. Blue mage may learn this ability as a 4th level spell (Knowledge: Arcana DC 23).",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Magnitude 8",
          "type": "su",
          "description": "Once every 1d6+1 rounds, an andagranda can cause the ground to erupt wildly around it within a 60-ft.-radius. Creatures within the area of effect take 15d10 points of earth damage and are inflicted with the weighted status effect for 1d8 rounds. They must make a successful Reflex save (DC 25) to reduce the damage by half and negate the status effect. The save DC is Constitution-based. Blue mages may learn this ability as a 8th level spell (Knowledge: Arcana DC 31).",
          "notes": {
            "familiar": ""
          }
        }
      ],
      "description": "This king of a gigantic centipede is covered with chitinous plates of hardened bone that run along its back in double rows. Its rear portion ends in a long, scorpion-like stinger and also likes to create massive earthquakes with its mighty stinger."
    },
