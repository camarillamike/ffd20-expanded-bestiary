    "rawSections": {
      "HEADER": [
        "Bestiary > Monstrous Humanoids > Gargoyle Family >",
        "Avizzard (CR 8)",
        "XP 4,800",
        "CE Medium monstrous humanoid (Earth)",
        "Init: +4; Senses darkvision 60 ft.; Perception +17"
      ],
      "DEFENSE": [
        "AC 23, touch 14, flat-footed 19 (+4 Dex, +9 natural)",
        "hp 95 [140] (10d10+40)",
        "mp 11",
        "Fort +7, Ref +11, Will +10",
        "DR 10/cold iron;",
        "Immune silenced;",
        "Resist earth 15, lightning 50%",
        "Weakness wind"
      ],
      "OFFENSE": [
        "Speed 40 ft., fly 60 ft. (average)",
        "Melee mwk shortsword +13/+8/+3 (1d6+4), mwk shortsword +13/+8 (1d6+4), bite +12 (1d6+2), gore +12 (1d6+2)",
        "Space 5 ft.; Reach 5 ft.",
        "Special Attacks Blood Drain, Silence Song, Spooky Laugh",
        "Spells Known (SC CL 10th; concentration +13)",
        "1st (DC 14) - Blizzard, Fire, Thunder"
      ],
      "TACTICS": [
        "During Combat: An avizzard doesn't have any free hands, what with dual-wielding shortswords, so it uses Still Spell if it needs to keep away and cast spells."
      ],
      "STATISTICS": [
        "Str 18, Dex 19, Con 18, Int 10, Wis 16, Cha 8",
        "Base Atk +10; CMB +17; CMD 29",
        "Feats Double Slice, Improved Two-Weapon Fighting, Multiattack, Two-Weapon Rend, Two-Weapon Fighting",
        "Skills Fly +18, Perception +17, Survival +17, Stealth +20 (+24 in stony areas); Racial Modifiers +2 Stealth (+6 in stony environments)",
        "Language Common, Terran",
        "SQ Freeze"
      ],
      "SPECIAL ABILITIES": [
        "Blood Drain (su) An avizzard can siphon blood from a target within 30 feet. The target must make a DC 18 Fortitude save or take 2d8 shadow damage and the avizzard is healed for that much. Blue mages may learn this ability as a 1st level spell (Knowledge: Local DC 17).",
        "Freeze (ex) An avizzard can hold itself so still, it appears to be a statue. An avizzard that uses freeze can take 20 on its Stealth check to hide in plain sight as a stone statue.",
        "Silence Song (su) Every 1d4 rounds as a standard action, an avizzard can sing a quieting tune at a victim within 30 feet, muting them. The target must make a DC 18 Will save or suffer the Silenced status for 1d4+1 rounds. This is a sonic effect.",
        "Spooky Laugh (su) Every 1d4 rounds as a standard action, an avizzard can mock and laugh at a victim within 30 feet, driving them into confusion. The target must make a DC 18 Will save or suffer the Confused status for 1d3 rounds. This is a sonic, mind-affecting effect."
      ],
      "ECOLOGY": [
        "Environment volcanic regions",
        "Organization small group (1-3)",
        "Treasure standard (2 mwk shortswords, other treasure)"
      ]
    },
