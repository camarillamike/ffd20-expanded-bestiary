        {
          "name": "Critical Attack",
          "type": "ex",
          "description": "Once every 1d4 rounds as a standard action, the blood bat can inflict more pain than normal. If they succeed at hitting with their bite attack, the damage is 2d6+3 x 1.5 for total damage.",
          "notes": {
            "familiar": ""
          }
