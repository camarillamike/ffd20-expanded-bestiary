      "specialAbilities": [
        {
          "name": "7 Nights of Calcabrina",
          "type": "su",
          "description": "This Burst Mode brings forth Calcabrina's inner focus and extra help when she reaches 50% health [136 HP]. For a number of rounds equal to 1 + 1 round for every four HD, Calcabrina can use Beatdown while using Brace and can summon twice as much help from Dollhouse. This limit break requires only a swift action to activate.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Beatdown",
          "type": "ex",
          "description": "Whenever struck by a melee attack, as an attack of opportunity, Calcabrina will return one slam strike at (+20) 3d8+20 points of damage. This cannot be used during Brace.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Brace",
          "type": "ex",
          "description": "Once every 1d4+1 rounds, Calcabrina can brace herself to take less damage while she is in that state. As a swift action, Calcabrina becomes Strong against Physical (50%) until the end of her next round however she cannot do anything else besides that.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Dollhouse",
          "type": "su",
          "description": "Once every 25% health reduced from her total as a swift action, Calcabrina can summon 1 Brina and Calca to help her in the fight.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Knockout",
          "type": "ex",
          "description": "Once every 1d3+1 rounds, Calcabrina will bring down the hammer, slamming with both of her fists at once. As a standard action, Calcabrina can hit at (+15) 4d8+20 points of bludgeoning damage.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Living-like",
          "type": "ex",
          "description": "Calcabrina gains the benefit of extra hit points from Charisma instead of size due to being a construct which means she can also be healed by normal means. She also gains feats and skills due to having an Intelligence. Her saves are also consider Good unlike most constructs.",
          "notes": {
            "familiar": ""
          }
        }
      ],
      "description": "The combined power of multiple Calca and Brina dolls that fight you as a huge deformed doll with great strength."
    },
