      "HEADER": [
        "Bestiary > Magical Beasts > Catoblepas Family >",
        "Catoblepas (CR 12)",
        "XP 19,200",
        "TN Huge Magical Beast",
        "Init -1; Senses Darkvision 60 ft., low-light vision; Perception +25",
        "Aura stench (30 ft., DC 23, 10 rounds)"
      ],
      "DEFENSE": [
        "AC 27, touch 7, flat-footed 27 (-1 Dex, +20 natural, -2 size)",
        "hp 161 [224] (14d10+84)",
        "Fort +15, Ref +8, Will +8",
        "SR 23"
      ],
      "OFFENSE": [
        "Speed 50 ft., swim 30 ft.",
        "Melee bite +18 (3d6+5/19-20), 2 hooves +16 (1d8+2)",
        "Space 15 ft.; Reach 15 ft.",
        "Special Attacks Demon Eye, Earthquake, Limit Glove, trample (4d6+7, DC 22)",
        "Spell-Like Abilities (CL 14th; concentration +16)",
        "3/day - Drain (DC 17), Thundara (DC 15)"
      ],
      "STATISTICS": [
        "Str 20, Dex 8, Con 22, Int 5, Wis 15, Cha 10",
        "Base Atk +14; CMB +20; CMD 29 (33 vs. trip)",
        "Feats Diehard, Endurance, Improved Critical (Bite), Iron Will, Multiattack, Power Attack, Skill Focus (Perception)",
        "Skills Perception +25, Swim +13; Racial Modifiers +8 Swim",
        "Languages Aklo"
      ],
      "SPECIAL ABILITIES": [
        "Demon Eye (Su)",
        "The dread gaze from a catoblepas's single eye works as a gaze attack, inflicting the Statue status permanently, with a range of 15 feet, Fortitude DC 23 negates. The save DC is Constitution-based.",
        "Earthquake (Su)",
        "Once every 1d3+1 rounds, a catoblepas can cause the ground to erupt around it within a 30-ft.-radius. Creatures within the area of effect take 8d6 points of earth damage and are inflicted with the Weighted status effect (Reflex save DC 19 for half damage and negates the status effect). Blue mages may learn this ability as a 4th level spell (Knowledge: Arcana DC 23).",
        "Limit Glove (Su)",
        "1/day, a catoblepas near to death can call a blast of energy upon a target within 30 feet, inflicting 28d6 damage, with a Reflex save (DC 19) for half damage. This ability may only be used if the catoblepas has 1 or fewer hp remaining. Blue mages may learn this ability as a 5th level spell (Knowledge: Arcana DC 25)."
      ],
      "ECOLOGY": [
        "Environment canyons, forests, and swamps",
        "Organization solitary or pair",
        "Treasure incidental"
      ]
    },
