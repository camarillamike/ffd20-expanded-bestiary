      "HEADER": [
        "Colossal Catoblepas (CR 13)",
        "XP 25,600",
        "TN Colossal Magical Beast",
        "Init -3; Senses Darkvision 60 ft., low-light vision; Perception +25",
        "Aura stench (30 ft., DC 23, 10 rounds)"
      ],
      "DEFENSE": [
        "AC 25, touch -1, flat-footed 25 (-3 Dex, +26 natural, -8 size)",
        "hp 217 [280] (14d10+140)",
        "Fort +19, Ref +6, Will +8",
        "SR 24"
      ],
      "OFFENSE": [
        "Speed 70 ft., swim 50 ft.",
        "Melee bite +15 (6d6+9/19-20), gore +15 (4d8+9), 2 hooves +13 (3d6+4)",
        "Space 25 ft.; Reach 25 ft.",
        "Special Attacks Earthquake, trample (8d6+13, DC 26)"
      ],
      "STATISTICS": [
        "Str 28, Dex 4, Con 30, Int 5, Wis 15, Cha 10",
        "Base Atk +14; CMB +20; CMD 29 (33 vs. trip)",
        "Feats Diehard, Endurance, Improved Critical (Bite), Iron Will, Multiattack, Power Attack, Skill Focus (Perception)",
        "Skills Perception +25, Swim +17; Racial Modifiers +8 Swim",
        "Languages Aklo"
      ],
      "SPECIAL ABILITIES": [
        "Earthquake (su) Once every 1d3+1 rounds, a colossal catoblepas can cause the ground to erupt around it within a 30-ft.-radius. Creatures within the area of effect take 8d6 points of earth damage and are inflicted with the Weighted status effect (Reflex save DC 19 for half damage and negates the status effect). Blue mages may learn this ability as a 4th level spell (Knowledge: Arcana DC 23)."
      ],
      "ECOLOGY": [
        "Environment swamps",
        "Organization solitary, pair, or pack (3-4)",
        "Treasure incidental"
      ]
    },
