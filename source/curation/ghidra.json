      "specialAbilities": [
        {
          "name": "Fast Healing",
          "type": "ex",
          "description": "A ghidra's fast healing ability is double to its current number of heads. A ghidra loses all fast healing when it is reduced to a single head.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Hydra Traits",
          "type": "ex",
          "description": "Any critical hit has a 75% chance to sever a head. You cannot sever the last head but a ghidra loses its fast healing if they only have one head remaining. A ghidra can't attack with a severed head, but takes no other penalties. A ghidra also loses one of its breath weapons per head lost.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Polar Bulwark",
          "type": "su",
          "description": "Once per day, a ghidra can become immune to physical damage for one round, must have at least two heads to use this ability and those two heads must channel this effect until the end of the round, while channeling, each other head may be used to perform an attack or a breath weapon.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Pyric Bulwark",
          "type": "su",
          "description": "Once per day, a ghidra can become immune to magical damage for one round, must have at least two heads to use this ability and those two heads must channel this effect until the end of the round, while channeling, each other head may be used to perform an attack or a breath weapon.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Pounce",
          "type": "ex",
          "description": "When a ghidra makes a charge, it can make a full attack.",
          "notes": {
            "familiar": ""
          }
        }
      ],
      "description": "A ghidra is a greater hydra with more heads, stronger bites, and stronger breath weapon."
    },
