    "rawSections": {
      "HEADER": [
        "Bestiary > Magical Beasts > Cockatrice Family >",
        "Hot Wings (CR 8)",
        "XP 4,800",
        "TN Small magical beast (Fire)",
        "Init: +4; Senses darkvision 60 ft., low-light vision; Perception +15",
        "Aura Shroud of Flame (5 ft., 1d6 fire, DC 19)"
      ],
      "DEFENSE": [
        "AC 21, touch 16, flat-footed 16 (+4 Dex, +1 dodge, +5 natural, +1 size)",
        "hp 75 [120] (10d10+20); fast healing 3",
        "mp 14",
        "Fort +9, Ref +11, Will +7",
        "Immune fire; Resist earth 10, ice 50%",
        "SR 19",
        "Weakness water"
      ],
      "OFFENSE": [
        "Speed 20 ft., fly 100 ft. (good)",
        "Melee bite +15 (1d4+1 plus 1d6 fire)",
        "Special Attacks Flame Sweep, Stone Beak",
        "Spells Known (SC CL 8th; concentration +14)",
        "2nd (DC 16) - Cure II"
      ],
      "STATISTICS": [
        "Str 12, Dex 19, Con 14, Int 10, Wis 15, Cha 19",
        "Base Atk +10; CMB +10; CMD 25",
        "Feats Dodge, Flyby Attack, Iron Will, Mobility, Weapon Finesse",
        "Skills Fly +23, Perception +15",
        "SQ Shroud of Flame"
      ],
      "SPECIAL ABILITIES": [
        "Flame Sweep (Su)",
        "Once every 1d4 rounds as a full-round action, a hot wings can become a streak of blazing fire, moving its speed, even through squares occupied by enemies, without provoking attacks of opportunity. Creatures whose squares the hot wings passed through suffer 5d6 fire damage and begin Burning as though affected by a 5th-level spell, with a DC 19 Reflex save to halve the damage and negate the status effect.",
        "Shroud of Flame (Su)",
        "A hot wings can cause its feathers to burst into fire or stop burning as a free action. As long as its feathers are burning, it inflicts an additional 1d6 points of fire damage with each natural attack, and any creature within reach (5 feet for most hot wings) must make a DC 17 Reflex save each round to avoid taking 1d6 points of fire damage at the start of its turn. A creature that attacks the hot wings with natural or non-reach melee weapons takes 1d6 points of fire damage (no save) with each successful hit. The save DC is Constitution-based.",
        "Stone Beak (Su)",
        "3/day as a standard action, a hot wings can inflict a painful peck that has a chance of turning its victim to stone. If they succeed at hitting with their bite attack, the damage is 1d4+1 x 1.5 plus 1d6 fire damage, and the victim must make a Fortitude save (DC 19) or suffer the Petrify status."
      ],
      "ECOLOGY": [
        "Environment volcanic regions",
        "Organization small group (1-3)",
        "Treasure incidental"
      ]
    },
