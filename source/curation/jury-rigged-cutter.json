      "HEADER": [
        "Jury-rigged Cutter (CR 13)",
        "XP 25,600",
        "N Large Construct (Machina)",
        "Init +8; Senses Darkvision 60 ft., low-light vision; Perception +19"
      ],
      "DEFENSE": [
        "AC 26, touch 12, flat-footed 19 (+3 Dex, +14 natural, -1 size)",
        "hp 153 [239] (19d10+49)",
        "Fort +11, Ref +13, Will +13",
        "Defensive Abilities hardness 5, resilient;",
        "Immune construct traits",
        "Weakness Critical hits and Lightning"
      ],
      "OFFENSE": [
        "Speed 40 ft.",
        "Melee 2 Buzz Saws +29 (2d12+10/19-20)",
        "Space 10 ft.; Reach 10 ft.",
        "Special Attacks Boosted Charge, Buzzsaw Blitz, Hundred Cuts"
      ],
      "STATISTICS": [
        "Str 30, Dex 18, Con -, Int 12, Wis 18, Cha 4",
        "Base Atk +19; CMB +29; CMD 47",
        "Feats Cleave, Critical Focus (Buzz Saw), Great Cleave, Great Fortitude, Improved Initiative, Improved Vital Strike, Power Attack, Toughness, Vital Strike, Weapon Focus (Buzz Saw)",
        "Skills Acrobatics +17, Perception +19, Sense Motive +19",
        "Languages Common (Cannot speak)"
      ],
      "SPECIAL ABILITIES": [
        "Boosted Charge (ex) 3/day, a jury-rigged cutter can make a full-attack action at the end of a charge instead of a single attack.",
        "Buzzsaw Blitz (ex) Once every 1d6+1 rounds, a jury-rigged cutter can perform one extra buzz saw attack with each saw as part of a full attack. This ability cannot be used in conjunction with the boosted charge ability.",
        "Hundred Cuts (ex) Once every 1d4+1 rounds, a jury-rigged cutter can perform a whirlwind attack. When the jury-rigged cutter uses the full-attack action, it can give up it's regular attacks and instead make one melee attack at it's highest base attack bonus against each opponent within reach. It must make a separate attack roll against each opponent.",
        "Resilient (ex) A jury-rigged cutter receive a +3 racial bonus on all saving throws."
      ]
    },
