    "rawSections": {
      "HEADER": [
        "Behemoth, King (CR 16) [Non-Boss version]",
        "XP 76,800",
        "N Huge Magical Beast",
        "Init +1; Senses Darkvision 60 ft., low-light vision, scent; Perception +19"
      ],
      "DEFENSE": [
        "AC 29, touch 9; flat-footed 26 (+18 natural, +1 dex, -2 size)",
        "hp 283 [378] (21d10+168)",
        "Fort +19, Ref +13, Will +9",
        "DR 5/adamantine; Immune bleed, curse, daze, sickening, stagger, stun; Resist ice/earth/lightning 5;"
      ],
      "OFFENSE": [
        "Speed 40 ft.",
        "Melee 2 Claws +29 (1d10+10), Gore +27 (2d6+10)",
        "Space 15 ft.; Reach 10 ft.",
        "Special Attacks Impale, Shockwave, Thunderbolt"
      ],
      "STATISTICS": [
        "Str 30, Dex 12, Con 24, Int 6, Wis 14, Cha 8",
        "Base Atk +21; CMB +33; CMD 44",
        "Feats Alertness, Charge Through, Cleave, Great Cleave, Combat Reflexes, Improved Bull Rush, Improved Natural Attack (Claw), Improved Overrun, Multiattack, Power Attack, Toughness",
        "Skills Acrobatics +14, Climb +22, Perception +19, Survival +15",
        "SQ Death befalls Meteor"
      ],
      "SPECIAL ABILITIES": [
        "Death befalls Meteor (su) Once a king behemoth reaches below 0 health, the king behemoth calls forth a Meteor (DC 22 Reflex save) on who ever struck the killing blow. If silenced or berserk this affect does nothing.",
        "Impale (ex) When charging, a king behemoth deals double damage with gore.",
        "Shockwave (su) Once every 1d4 rounds, a king behemoth can cause the ground to quake that ripples from it within a 30-ft.-radius spread. Creatures within the area of effect take 8d6 points of earth damage, inflicted with the Weighted status effect for 1d6 rounds, and are pushed back 5 feet per 10 damage sustained. A successful Reflex save (DC 22) reduces damage by half, negates the status effect, and stops being pushed back. Blue mages may learn this ability as a 4th level spell (Knowledge: Arcana DC 23).",
        "Thunderbolt (su) Once every 1d4 rounds, a king behemoth can discharge a large lightning storm within 120 ft. and in a 40-ft.-radius. Creatures within the area of effect take 10d6 points of lightning damage and are inflicted with Static status effect for 1d4 rounds. A successful Reflex save (DC 22) reduces the damage by half and negates the status effect. Blue mages may learn this ability as a 5th level spell (Knowledge: Arcana DC 25)."
      ]
    },
