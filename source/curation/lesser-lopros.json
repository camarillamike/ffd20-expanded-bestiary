        "Languages Draconic"
      ],
      "SPECIAL ABILITIES": [
        "Poison (Ex)",
        "Sting - injury; Fortitude save DC 20; frequency 1/round for 6 rounds; effect 1d4 Constitution damage; cure 2 consecutive saves. The save DC is Constitution-based.",
