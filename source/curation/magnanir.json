      "OFFENSE": [
        "Speed 60 ft.",
        "Melee Gore +11 (2d6+5), 2 Hooves +8 (1d6+2); if horn is broken: Bite +10 (1d8+5), 2 Hooves +8 (1d6+2)",
        "Range: Sickle-horn +9 (1d8+5/x4)",
