    "rawSections": {
      "HEADER": [
        "Bestiary > Magical Beasts > Squid Family >",
        "Phanquid (CR 5)",
        "XP 1,600",
        "N Large magical beast (Aquatic)",
        "Init: +5; Senses low-light vision; Perception +13"
      ],
      "DEFENSE": [
        "AC 19, touch 14, flat-footed 14 (+5 Dex, +5 natural, -1 size)",
        "hp 45 [72] (6d10+12)",
        "Fort +7, Ref +10, Will +3",
        "Defensive Ability Ink Cloud (20-ft. radius)",
        "Resist lightning 5, water 10, wind 5",
        "Weakness fire"
      ],
      "OFFENSE": [
        "Speed 30 ft., swim 60 ft., jet 250 ft.",
        "Melee bite +10 (1d8+5), 2 arms +10 (1d4+5 plus drain), tentacles +8 (3d6+2 plus grab)",
        "Space 10 ft.; Reach 10 ft. (20 ft. with arms and tentacles)",
        "Special Attacks Blackness, breath weapon (60-ft. line, 5d6 ice damage, Reflex DC 15 for half, usable every 1d4 rounds), constrict (3d6+7), Electrapulse"
      ],
      "STATISTICS": [
        "Str 21, Dex 21, Con 15, Int 2, Wis 12, Cha 2",
        "Base Atk +6; CMB +12 (+16 grapple); CMD 27 (35 vs. trip)",
        "Feats Combat Reflexes, Multiattack, Skill Focus (Perception)",
        "Skills Perception +13, Swim +13",
        "SQ Water Dependency"
      ],
      "SPECIAL ABILITIES": [
        "Blackness (Ex)",
        "Once per minute as a standard action while not underwater, a phanquid can squirt forth a blast of acidic, blinding ink at a single target within 60 feet as a ranged touch attack (+10), dealing 4d6 water damage and inflicting the Blinded status for 1d10+1 rounds. A DC 15 Fortitude save negates the status effect. This ability uses the same cooldown as ink cloud.",
        "Drain (Su)",
        "The suckers on a phanquid's arms drain the life force from living creatures, healing it for the amount of damage it deals with arm attacks.",
        "Electrapulse (Su)",
        "Once every 1d3 rounds as a standard action, a phanquid can pulse forth deadly electricity towards a single target within 60 ft., dealing 3d6 lightning damage and inflicting the Static status as though from a 3rd-level spell, as well as a -3 penalty to all magical damage and healing, for 1d6 rounds. A DC 14 Reflex save halves the damage and negates both status effects.",
        "Ink Cloud (Ex)",
        "A phanquid can emit a 20-foot-radius cloud of ink once per minute as a free action while underwater. This cloud provides total concealment. The ink persists for 1 minute.",
        "Water Dependency (Ex)",
        "Phanquids can survive out of the water for 1 hour per point of Constitution. Beyond this limit, a phanquid runs the risk of suffocation, as if it were drowning."
      ],
      "ECOLOGY": [
        "Environment arctic",
        "Organization small group (1-3)",
        "Treasure incidental"
      ]
    },
