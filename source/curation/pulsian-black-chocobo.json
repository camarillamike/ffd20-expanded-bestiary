      "HEADER": [
        "Bestiary > Magical Beasts > Gran Pulse Chocobo Family >",
        "Chocobo, Pulsian Black (CR 10)",
        "XP 9,600",
        "N Large Magical Beast (Avian)",
        "Init +10; Senses darkvision 60 ft., low-light vision, scent; Perception +15",
        "Aura stench (30 ft., DC 26, 10 rounds)"
      ],
      "DEFENSE": [
        "AC 28, touch 15, flat-footed 23 (+5 Dex, +13 natural, +1 dodge, -1 size )",
        "hp 201 [260] (13d10+130)",
