        },
        {
          "name": "Sandwalking",
          "type": "ex",
          "description": "Pulsian silver chocobos travel at full speed across sand, rocky ground, or dust, and leaves no trail behind unless it chooses to.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Surefooted Stride",
          "type": "ex",
          "description": "Pulsian silver chocobos may move through any sort of difficult terrain (such as thorns, overgrown areas, rubble and the like) at its normal speed without taking damage or suffering any other impairment. Areas that have been magically manipulated, however, still affect it.",
          "notes": {
            "familiar": ""
          }
        },
