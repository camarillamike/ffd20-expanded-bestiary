        "Immune poison; Resist Water 15, Fire 10",
        "Weakness Ice"
      ],
      "OFFENSE": [
        "Speed 40 ft., climb 40 ft., swim 40 ft.",
        "Melee Bite +22 (4d6+19/19-20 plus poison and grab)",
