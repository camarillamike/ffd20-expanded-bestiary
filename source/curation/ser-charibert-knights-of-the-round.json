      "specialAbilities": [
        {
          "name": "Elemental Shield",
          "type": "su",
          "description": "3/day, Ser Charibert can use his knowledge of the elements and shield allies for a brief duration. As an immediate action, he can shield himself and allies within 30 feet from elemental damage, gaining Elemental Resistance 20 to all elements (earth, fire, ice, lightning, water, and wind) until the start of his next turn.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Heavensflame",
          "type": "su",
          "description": "Once every 1d3+1 rounds as a standard action, Ser Charibert places 30-ft.-radius red puddles underneath each target within 240-feet away from him. The puddles deal 8d8 points of fire damage unless they make a Reflex save (DC 37) for half damage. This leaves red puddles of flames on the ground where each target was standing on for five more rounds after dealing 6d6 points of fire damage per round while anyone is on that space.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Holy Chain",
          "type": "su",
          "description": "Once every other round as a standard action, Ser Charibert links a divine chain between two targets within 120-ft. away that must be 30 feet apart. Those two are tethered together take 4d6 points of (half fire/holy) damage per round until they're at least 60 feet apart. They can make a Fortitude save (DC 35) per round to half the damage taken. This ability cannot be dispel or cured.",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Lava Blast",
          "type": "su",
          "description": "Once every 1d2+1 rounds as a standard action, Ser Charibert shoots out a blast of lava from his hand within 30 feet. He must make a ranged touch attack to hit, and if the ray hits, it deals 16d6 points of fire damage and the target must make a Fortitude save (DC 35) or be inflicted with Burning and Entrangled status effects. Blue mages may learn this ability as a 7th level spell (Knowledge: Planes DC 29).",
          "notes": {
            "familiar": ""
          }
        },
        {
          "name": "Power Weapon User",
          "type": "ex",
          "description": "Ser Charibert can use power weapons as if they had MP.",
          "notes": {
            "familiar": ""
          }
        }
      ],
      "description": "Ser Charibert serves in King Thordan's Knights of the Round. This sheet uses the shared knight traits and Ser Charibert's individual statistics, equipment and abilities."
