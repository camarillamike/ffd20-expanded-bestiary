      ],
      "DEFENSE": [
        "AC 16, touch 9, flat-footed 16 (+7 natural, -1 size)",
        "hp 84 [120] (5d8+20)",
        "Fort +8, Ref +1, Will +4",
        "DR 5/magic",
        "Immune death effects, ice, mind-affecting effects, paralyzed, petrified, poisoned, sleep; Resist water 10",
        "Weakness lightning"
      ],
      "OFFENSE": [
        "Speed 30 ft., swim 20 ft.",
        "Melee 2 claws +9 (1d6+10 plus grab)",
        "Space 10 ft.; Reach 10 ft.",
        "Special Attacks Confusing Gaze, constrict (1d6+10), Giant Blade, Icy Foam, Tornado"
      ],
      "STATISTICS": [
        "Str 30, Dex 11, Con 18, Int —, Wis 16, Cha 2",
        "Base Atk +3; CMB +14 (+18 grapple); CMD 24 (36 vs. trip)",
        "Skills Perception +4, Swim +18; Racial Modifiers +4 Perception",
        "SQ Extreme Durability, Water Dependency"
      ],
      "SPECIAL ABILITIES": [
        "Confusing Gaze (su) Every 1d4+1 rounds, a snow crab may lock eyes with a single target within 30 feet as a standard action, driving it to confusion. The target must make a DC 15 Will save or suffer the Confused status effect for 1d4 rounds. This is a mind-affecting effect. Blue mages may learn this ability as a 4th level spell (Knowledge: Nature DC 23).",
        "Extreme Durability (ex) A snow crab has double hit points and maximum rolls on its hit dice.",
        "Giant Blade (ex) Every 1d4 rounds, a snow crab can make one claw attack as a standard action for 2d6+20 damage that cannot begin a grab.",
        "Icy Foam (su) 3/day as a standard action, a snow crab may spew forth icy foam at a single target within 35 feet as a ranged touch attack (+2), dealing 3d6+8 ice damage on a successful hit.",
        "Tornado (su) 3/day as a standard action, a snow crab may spew forth tornado-force winds at a single target within 35 feet as a ranged touch attack (+2), dealing 3d6+8 wind damage on a successful hit.",
        "Water Dependency (ex) Crabs can survive out of the water for 1 hour per point of Constitution. Beyond this limit, a crab runs the risk of suffocation, as if it were drowning."
      ],
      "ECOLOGY": [
        "Environment arctic",
        "Organization solo or with 2 desert sahagin warriors",
        "Treasure triple"
      ]
    },
