      ],
      "DEFENSE": [
        "AC 21, touch 11, flat-footed 19(+2 dex, +10 natural, -1 size)",
        "hp 84 (8d10+40)",
        "Fort +11, Ref +10, Will +3",
        "Defensive Abilities Poisonous Skin; Immune Poison, Frog",
        "Weakness Ice"
      ],
